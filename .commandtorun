docker compose -f compose.prod.yaml up -d --build
docker compose -f compose.prod.yaml stop

# Initialize app key if not set in .env.prod
docker compose -f compose.prod.yaml exec -T app php artisan key:generate --force

# Fix permissions for Laravel writable paths
docker compose -f compose.prod.yaml exec -T app chmod -R 775 storage bootstrap/cache
docker compose exec app bash -lc "php artisan migrate --force && php artisan migrate:status" 

docker compose -f compose.prod.yaml exec app sh -lc 'chown -R www-data:www-data storage bootstrap/cache && chmod -R 775 storage bootstrap/cache && php artisan config:clear' 
docker compose -f compose.prod.yaml exec app sh -lc "php -r \"require __DIR__.'/bootstrap/app.php'; \$app->make(Illuminate\\Contracts\\Console\\Kernel::class)->bootstrap(); \\Log::info('Docker log write test'); echo 'Logged';\"" && tail -n 100 storage/logs/laravel.log || true 

#Certificates
docker compose -f compose.prod.yaml run --rm --entrypoint "/bin/sh -c 'mkdir -p /etc/letsencrypt/live/impazamon.powertel.co.zw && openssl req -x509 -nodes -newkey rsa:2048 -days 1 -keyout /etc/letsencrypt/live/impazamon.powertel.co.zw/privkey.pem -out /etc/letsencrypt/live/impazamon.powertel.co.zw/fullchain.pem -subj \"/CN=impazamon.powertel.co.zw\"'" certbot 
docker compose -f compose.prod.yaml restart nginx && docker compose -f compose.prod.yaml run --rm --entrypoint "certbot certonly --webroot -w /var/www/certbot --email development@powertel.co.zw --agree-tos -d impazamon.powertel.co.zw --rsa-key-size 4096" certbot && docker compose -f compose.prod.yaml exec nginx nginx -s reload 
docker compose -f compose.prod.yaml run --rm certbot renew

Common next commands:

- docker compose -f compose.prod.yaml logs -f nginx to tail Nginx logs.
- docker compose -f compose.prod.yaml exec -T app php artisan migrate --force
- docker compose -f compose.prod.yaml exec -T app php artisan config:cache && docker compose -f compose.prod.yaml exec -T app php artisan route:cache && docker compose -f compose.prod.yaml exec -T app php artisan view:cache

